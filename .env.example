# Copiar este archivo como ".env.local" y completar con los valores reales
# generados al registrar la aplicación en Microsoft Entra ID y al crear
# el sitio de SharePoint. Ver README.md sección "Configuración inicial".

# --- Microsoft Entra ID (Azure AD) ---

# Recomendado: REUTILIZAR el mismo registro de aplicación en Entra ID que ya
# usan las otras apps de Cercafe (Inspección Pulmonar, Auditoría Grasa Dorsal,
# etc.) en vez de crear uno nuevo — evita pedir un nuevo consentimiento de
# administrador. Esta app sigue siendo un proyecto de código aparte; solo se
# comparte la identidad en Entra ID, no el repositorio. Ver la sección 2 del
# README para el paso a paso.

# Application (client) ID del registro de tipo SPA
VITE_AAD_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Directory (tenant) ID de la organización
VITE_AAD_TENANT_ID=00000000-0000-0000-0000-000000000000

# Debe coincidir EXACTAMENTE con el redirect URI configurado en el registro,
# incluida la barra final y el nombre del repositorio si se publica en
# GitHub Pages bajo una subruta (https://usuario.github.io/repo/)
VITE_AAD_REDIRECT_URI=http://localhost:5173/

# --- SharePoint ---

# Hostname del tenant, ej: cercafeia.sharepoint.com
VITE_SP_HOSTNAME=tuempresa.sharepoint.com

# Ruta del sitio (después de /sites/), ej: para
# https://tuempresa.sharepoint.com/sites/RecepcionCerdos usar:
VITE_SP_SITE_PATH=/sites/RecepcionCerdos
